/* Dark Glassmorphism & Odin-Style Theme */

.root-container {
    background-color: #1a1a2e;
}

.glass-panel {
    background-color: rgba(30, 30, 45, 0.6);
    border-radius: 12px;
    border-top-color: rgba(255, 255, 255, 0.15);
    border-right-color: rgba(255, 255, 255, 0.05);
    border-bottom-color: rgba(255, 255, 255, 0.05);
    /* Odin Trope: Thick, vibrant left accent border for main panels */
    border-left-width: 4px;
    border-left-color: #3a86ff; 
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
}

.glass-button {
    background-color: rgba(33, 150, 243, 0.8);
    border-radius: 8px;
    border-left-color: rgba(255, 255, 255, 0.3);
    border-top-color: rgba(255, 255, 255, 0.3);
    border-right-color: rgba(0, 0, 0, 0.3);
    border-bottom-color: rgba(0, 0, 0, 0.3);
    border-width: 1px;
    color: white;
    text-shadow: 0px 2px 4px rgba(0, 0, 0, 0.5); /* Glowing text shadow */
    transition-duration: 0.2s;
    transition-property: scale, background-color;
}

.glass-button:hover {
    background-color: rgba(66, 165, 245, 0.95);
    scale: 1.02;
}

.glass-button:active {
    scale: 0.98;
    background-color: rgba(21, 101, 192, 1.0);
}

/* Odin Trope: Sleek Group Boxes with colored accents and bold headers */
.unity-group-box {
    background-color: rgba(0, 0, 0, 0.15);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.05);
    border-left-width: 3px;
    border-left-color: #00e5ff; /* Cyan accent */
    margin-top: 10px;
    padding: 8px;
}

.unity-group-box__label {
    -unity-font-style: bold;
    color: #00e5ff; /* Match the accent */
    margin-bottom: 5px;
    padding-left: 2px;
}

/* Odin Trope: Minimalist, flat Toolbars with subtle contrast */
.unity-toolbar {
    background-color: rgba(15, 15, 25, 0.9);
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
}

.unity-two-pane-split-view__dragline {
    background-color: rgba(255, 255, 255, 0.10);
}

/* Odin Trope: Deep-inset Fields and Sliders */
.unity-base-field__input {
    background-color: rgba(0, 0, 0, 0.4);
    border-color: rgba(255, 255, 255, 0.1);
    border-radius: 4px;
}

/* Odin Trope: Tinted HelpBoxes with bold left bars */
.unity-help-box {
    background-color: rgba(33, 150, 243, 0.1);
    border-radius: 6px;
    border-width: 1px;
    border-color: transparent;
    border-left-width: 4px;
    border-left-color: #2196f3;
    color: #e0e0e0;
}

/* Odin Trope: Flat Toolbar Items */
.unity-toolbar-button, .unity-toolbar-menu {
    background-color: transparent;
    border-width: 0px;
    color: #e0e0e0;
}

.unity-toolbar-button:hover, .unity-toolbar-menu:hover {
    background-color: rgba(255, 255, 255, 0.1);
}

.unity-toolbar-button:active, .unity-toolbar-menu:active {
    background-color: rgba(255, 255, 255, 0.2);
}

